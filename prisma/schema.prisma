generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  image        String?
  passwordHash String?
  role         String  @default("USER")

  createdAt DateTime @default(now())

  accounts       Account[]
  sessions       Session[]
  participations Participation[]
  wonPrizes      WonPrize[]
}

// ─── NextAuth adapter tables ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Contests ─────────────────────────────────────────────────────────────────

model Contest {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  scheduledAt        DateTime
  registrationOpenAt DateTime
  status             String   @default("UPCOMING")
  maxParticipants    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  participations Participation[]
  contestPrizes  ContestPrize[]
  wonPrizes      WonPrize[]
}

// ─── Participation ────────────────────────────────────────────────────────────

model Participation {
  id           String   @id @default(cuid())
  userId       String
  contestId    String
  joinedAt     DateTime @default(now())
  ticketNumber Int

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId])
  @@index([contestId])
}

// ─── Prizes ───────────────────────────────────────────────────────────────────

model Prize {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  value       Float?
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  contestPrizes ContestPrize[]
}

model ContestPrize {
  id        String @id @default(cuid())
  contestId String
  prizeId   String
  rank      Int

  contest  Contest   @relation(fields: [contestId], references: [id])
  prize    Prize     @relation(fields: [prizeId], references: [id])
  wonPrize WonPrize?

  @@unique([contestId, rank])
}

model WonPrize {
  id             String   @id @default(cuid())
  contestId      String
  userId         String
  contestPrizeId String   @unique
  drawnAt        DateTime @default(now())
  claimed        Boolean  @default(false)

  contest      Contest      @relation(fields: [contestId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  contestPrize ContestPrize @relation(fields: [contestPrizeId], references: [id])
}
